@model List<GayatriCateringPortal.Models.DriverInvoiceVM>

@{
    Layout = null;
    ViewData["Title"] = "My Deliveries";

}

<!DOCTYPE html>

<html>

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>My Deliveries</title>

    <link href="~/css/driver/driver-delivery.css"
          rel="stylesheet"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />

</head>

<body>

    <div class="mobile-container">

        <div class="top-bar">

            <div>

                <h2>

                    <i class="fa-solid fa-truck-fast"></i>

                    My Deliveries

                </h2>

                <span>

                    Today's Assigned Deliveries

                </span>

            </div>

        </div>

        @if (Model.Count == 0)
        {
            <div class="empty-card">

                <i class="fa-solid fa-box-open"></i>

                <h3>No Deliveries Assigned</h3>

                <p>

                    There are no pending deliveries assigned to you.

                </p>

            </div>
        }
        else
        {
            var foundNextPending = false;
            var stopNumber = 0;

            foreach (var item in Model)
            {
                stopNumber++;
                var isDelivered = string.Equals(item.Status, "Delivered", StringComparison.OrdinalIgnoreCase);
                var isNextPending = !isDelivered && !foundNextPending;

                if (!isDelivered)
                {
                    foundNextPending = true;
                }

                <div class="delivery-card">

                    <div class="delivery-header">

                        <div>

                            <div class="invoice-no">

                                @item.InvoiceNo

                            </div>

                            <div class="customer-name">

                                @item.CustomerName

                            </div>

                        </div>

                        @if (isDelivered)
                        {
                            <span class="status delivered">Delivered</span>
                        }
                        else if (isNextPending)
                        {
                            <span class="status pending">Next stop</span>
                        }
                        else
                        {
                            <span class="status">Stop @stopNumber</span>
                        }

                    </div>

                    <div class="delivery-body">

                        <div class="info">

                            <i class="fa-solid fa-calendar-days"></i>

                            @item.EventDate.ToString("dd MMM yyyy")

                        </div>

                        <div class="info">

                            <i class="fa-solid fa-location-dot"></i>

                            @item.DeliveryAddress

                        </div>

                    </div>

                    <div class="delivery-footer">

                        @if (isDelivered)
                        {
                            <button class="btn-start disabled" disabled>Delivered</button>
                        }
                        else if (isNextPending)
                        {
                            <a href="/DriverDelivery/Delivery?logisticsId=@item.LogisticsId"
                               class="btn-start">Start Delivery</a>
                        }
                        else
                        {
                            <button class="btn-start disabled" disabled>Complete previous delivery first</button>
                        }

                    </div>

                </div>

            }
        }

    </div>

</body>

</html>
