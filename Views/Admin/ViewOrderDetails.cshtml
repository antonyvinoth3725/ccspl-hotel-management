@{
    ViewData["Title"] = "View Order Details";
}

@section Styles {
    <link rel="stylesheet" href="~/css/customer/order.css" asp-append-version="true">
        <style>
            body.admin-mode .app-footer {
                position: fixed;
                left: 0;
                right: 0;
                bottom: 0;
                height: var(--app-footer-height);
                margin-top: 0;
            }

            .view-order-heading {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 20px
            }

                .view-order-heading h1 {
                    font-family: Georgia,'Times New Roman',serif;
                    color: var(--green-dark);
                    margin: 0
                }

                .view-order-heading p {
                    margin: 5px 0;
                    color: var(--gray-600)
                }

            .view-order-state {
                padding: 35px;
                text-align: center;
                background: #fff;
                border: 1px solid var(--gray-200);
                border-radius: 14px
            }

            .view-order-hidden {
                display: none !important
            }

            .view-order-report {
                background: #fff
            }

            .view-order-empty {
                text-align: right;
                color: var(--gray-600) !important;
                padding: 18px !important
            }

            .included-pill {
                display: inline-block;
                padding: 5px 14px;
                border-radius: 999px;
                background: #d1fae5;
                color: #047857;
                font-weight: 800;
                font-size: 12px
            }

            .report-review .review-table td:last-child {
                text-align: right
            }

            .page-header-actions {
                display: flex;
                gap: 8px;
                align-items: center
            }

            .header-action-btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 7px;
                min-height: 34px;
                padding: 7px 13px;
                border-radius: 10px;
                font-size: 14px;
                font-weight: 700;
                letter-spacing: .01em;
                transition: transform .15s ease, box-shadow .15s ease, background .15s ease, color .15s ease
            }

            .header-action-btn:hover {
                transform: translateY(-1px)
            }

            .header-action-icon {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 14px;
                font-size: 13px;
                line-height: 1
            }

            #btnSendOrderEmail {
                background: linear-gradient(135deg,#1d4ed8,#2563eb);
                border-color: #1d4ed8;
                color: #fff;
                box-shadow: 0 8px 18px rgba(37,99,235,.14)
            }

            #btnSendOrderEmail:hover {
                background: linear-gradient(135deg,#1e40af,#1d4ed8);
                color: #fff
            }

            #btnSendOrderWhatsapp {
                background: linear-gradient(135deg,#16a34a,#22c55e);
                border-color: #16a34a;
                color: #fff;
                box-shadow: 0 8px 18px rgba(34,197,94,.14)
            }

            #btnSendOrderWhatsapp:hover {
                background: linear-gradient(135deg,#15803d,#16a34a);
                color: #fff
            }

            #btnDownloadOrderPdf {
                background: linear-gradient(135deg,#0f766e,#0d9488);
                border-color: #0f766e;
                color: #fff;
                box-shadow: 0 8px 18px rgba(13,148,136,.14)
            }

            #btnDownloadOrderPdf:hover {
                background: linear-gradient(135deg,#115e59,#0f766e);
                color: #fff
            }
        </style>
    }

    <div class="view-order-heading">
        <div>
            <h1 id="pageTitle">Order Details</h1>
            <p id="pageSubTitle">Complete catering order summary</p>
        </div>
        <div class="page-header-actions">
            <button class="btn btn-primary header-action-btn" type="button" id="btnSendOrderEmail">
                <span class="header-action-icon" aria-hidden="true">&#9993;</span>
                <span>Email</span>
            </button>
            <button class="btn btn-orange header-action-btn" type="button" id="btnSendOrderWhatsapp">
                <span class="header-action-icon" aria-hidden="true">&#128172;</span>
                <span>WhatsApp</span>
            </button>
            <button class="btn btn-primary header-action-btn" type="button" id="btnDownloadOrderPdf">
                <span class="header-action-icon" aria-hidden="true">&#11015;</span>
                <span>Download</span>
            </button>
            <button class="btn btn-light" type="button" onclick="history.back()">&larr; Back</button>
        </div>
    </div>
    <div id="viewOrderState" class="view-order-state">Loading order details...</div>
    <div id="viewOrderReport" class="review-sheet report-review view-order-report view-order-hidden" data-order-id="@ViewData["OrderId"]">
        <div class="review-top">
            <div class="review-brand"><img class="review-logo" src="~/images/logo.jpg" alt="Gayatri Restaurant logo"></div>
            <div class="review-line"><div class="review-title">Gayatri Restaurant Pte Ltd</div>Co. Regn. No. 52817812A<br>Main Restaurant: 122 Race Course Road #01-01, Singapore 218583<br>Tel: 6291 1011 &nbsp;|&nbsp; Office Tel: 6292 4544 &nbsp;|&nbsp; Fax: 62974850<br>Email: info@gayatrirestaurant.com<br>WhatsApp: +65 6294 6294 &nbsp;|&nbsp; Website: www.gayatrirestaurant.com</div>
        </div>
        <div class="review-quote-meta"><span id="orderNumber"></span><span id="orderDate"></span><span id="orderStatus"></span></div>
        <div class="review-split"><div><strong>Customer</strong><div id="customerInfo"></div></div><div><strong>Event</strong><div id="eventInfo"></div></div></div>
        <div id="orderSections"></div>
        <section class="review-section review-payment-section"><div class="review-table-title">Payment Summary</div><div class="review-table-wrap"><table class="item-table review-table review-payment-table"><tbody id="paymentSummary"></tbody></table></div></section>
    </div>

