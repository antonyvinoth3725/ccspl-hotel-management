@{
    ViewData["Title"] = "Add Ons";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/addons.css" asp-append-version="true">
}

<div class="page-header">
    <div>
        <div class="page-title">Add Ons</div>
        <div class="page-subtitle">Create and manage additional menu items and rates</div>
    </div>
</div>

<div id="addOnsListPanel" class="card">
    <div class="panel-header">
        <div class="panel-title">Manage Add Ons</div>
        <div class="panel-actions">
            <div class="app-header-filter">
                <input type="text" id="addOnsSearch" class="tbl-search" data-table="addOnsList" placeholder="Search add ons...">
            </div>
            <button type="button" class="btn btn-orange btn-add" id="btnAddAddOn" data-permission="create" onclick="openAddOnModal()">+ Add On</button>
        </div>
    </div>
        <div class="pageloaderpanel hidden">
        <div class="spinner"></div>
        <div class="loader-text">Loading add ons...</div>
    </div>
    <div class="table-wrap">
        <table class="tbl" id="addOnsList" data-page-size="10">
            <thead>
                <tr>
                    <th class="sortable">#</th>
                    <th class="sortable">Code</th>
                    <th class="sortable">Add On Name</th>
                    <th class="sortable">Unit Type</th>
                    <th class="sortable">Rate</th>
                    <th class="sortable">Status</th>
                    <th class="no-sort">Actions</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<div class="modal-overlay hidden" id="addOnModal">
    <div class="modal-box">
        <div class="modal-header">
            <span class="modal-title" id="addOnModalTitle">Create Add On</span>
            <button class="modal-close" type="button" id="btnCloseAddOnModal" onclick="closeAddOnModal()">&#10005;</button>
        </div>
        <input type="hidden" id="addOnId">
        <div class="form-group">
            <label>Code <span class="field-required">*</span></label>
            <input type="text" id="addOnCode" class="form-control" maxlength="20" placeholder="Enter add on code" disabled>
            <div class="field-error hidden" id="addOnCodeError"></div>
        </div>
        <div class="form-group">
            <label>Add On Name <span class="field-required">*</span></label>
            <input type="text" id="addOnName" class="form-control" maxlength="500" placeholder="Enter add on name">
            <div class="field-error hidden" id="addOnNameError"></div>
        </div>
        <div class="form-group">
            <label>Unit Type <span class="field-required">*</span></label>
            <input type="text" id="addOnUnitType" class="form-control" maxlength="20" placeholder="Example: Each, Tray, Pax">
            <div class="field-error hidden" id="addOnUnitTypeError"></div>
        </div>
        <div class="form-group">
            <label>Rate <span class="field-required">*</span></label>
            <input type="number" id="addOnRate" class="form-control" min="0" step="0.01" placeholder="0.00">
            <div class="field-error hidden" id="addOnRateError"></div>
        </div>
        <div class="actions">
            <button type="button" class="btn btn-light" id="btnClearAddOn" onclick="clearAddOnForm(true)">Clear</button>
            <button type="button" class="btn btn-primary" id="btnSaveAddOn" onclick="saveAddOn()">Save</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin/table-utils.js" asp-append-version="true"></script>
    <script src="~/js/admin/addons.js" asp-append-version="true"></script>
}


